<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tlx.ctbb-poll</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>/Users/soural/Documents/TLX/bin/ctbb-poll.sh &gt;&gt; /Users/soural/Documents/TLX/wiki/sources/podcasts/ct/whisper/_poll_launchd.log 2&gt;&amp;1</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/soural/Documents/TLX</string>

    <!-- Run daily at 09:30 local. CT publishes Thu 10:00 UTC ≈ 02:00 PST / 05:00 EST. 09:30 local catches it the same morning regardless of TZ. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>

    <!-- Also a one-shot 5 min after login, in case the machine was asleep at the scheduled time. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/soural/Documents/TLX/wiki/sources/podcasts/ct/whisper/_poll_launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/soural/Documents/TLX/wiki/sources/podcasts/ct/whisper/_poll_launchd.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- Throttle: never re-run within 6 hours even if launchd tries. -->
    <key>ThrottleInterval</key>
    <integer>21600</integer>

    <!-- Don't run while on battery + low power. -->
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
