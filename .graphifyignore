# Per-engagement target dirs — scope, downloads, intermediates, findings.
# All operational data, not tools/wiki. Graph the *tools* (tlx/, wiki/, skills/, bin/).
targets/*
!targets/_TEMPLATE_http.md

# Graphify's own outputs — don't recurse into prior graph builds
graphify-out/

# Wiki — entire tree excluded. Wiki has its own RAG collection (3072d Gemini)
# and its own llmwiki maintenance loop (wiki-lint, wiki-query). Graphing it
# dilutes the *tools* graph signal with prose/podcast/finding entries.
wiki/
inbox/

# Wiki source media (legacy guard — covered by wiki/sources/ above)
wiki/sources/**/audio_tmp/
wiki/sources/**/*.wav
wiki/sources/**/*.mp3
wiki/sources/**/*.m4a
wiki/sources/**/*.flac
wiki/sources/**/*.ogg
wiki/sources/**/*.mp4
wiki/sources/**/*.mkv
wiki/sources/**/*.webm

# TLX runtime + caches
.tlx/
chroma/
__pycache__/
*.pyc
.venv/

# Secrets (defense in depth — gitignore already covers these)
**/auth_cache.json
**/cookies.json
**/.env
**/.env.*
**/credentials.json
**/peer_ids.json
