# Per-engagement downloads — raw JS/HTML/CSS from targets, exploded source trees,
# index/chains/opus intermediates. Big, regenerable, low semantic signal for graph.
# Graph the *tools* (tlx/, wiki/, skills/, bin/), not the target payload.
targets/*/raw/
targets/*/sources/
targets/*/index/
targets/*/chains/
targets/*/opus/
targets/*/caido/
targets/*/autoresearch.jsonl

# Graphify's own outputs — don't recurse into prior graph builds
graphify-out/

# TLX runtime + caches
.tlx/
chroma/
__pycache__/
*.pyc
.venv/

# Secrets (defense in depth — gitignore already covers these)
**/auth_cache.json
**/cookies.json
**/.env
**/.env.*
**/credentials.json
**/peer_ids.json
