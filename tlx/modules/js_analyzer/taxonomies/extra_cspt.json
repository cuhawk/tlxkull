[
  {
    "id": "cspt_fetch_url_concat",
    "pattern": "fetch\\s*\\(\\s*[`'\"][^`'\"]*\\$\\{",
    "kind": "sink",
    "severity": "medium",
    "description": "fetch(...) URL built via template-literal interpolation — CSPT candidate (Doyensec CSPT2CSRF playbook)"
  },
  {
    "id": "cspt_xhr_open_concat",
    "pattern": "\\.open\\s*\\(\\s*['\"](?:POST|PUT|PATCH|DELETE)['\"]\\s*,\\s*[`'\"][^`'\"]*(?:\\$\\{|\"\\s*\\+|'\\s*\\+)",
    "kind": "sink",
    "severity": "high",
    "description": "XMLHttpRequest.open(MUTATING_VERB, url-with-concat) — CSPT-2-CSRF candidate"
  },
  {
    "id": "cspt_axios_method_url",
    "pattern": "axios\\.(?:post|put|patch|delete)\\s*\\(\\s*[`'\"][^`'\"]*(?:\\$\\{|\"\\s*\\+|'\\s*\\+)",
    "kind": "sink",
    "severity": "high",
    "description": "axios.{post,put,patch,delete}(url-with-concat, ...) — CSPT-2-CSRF candidate"
  },
  {
    "id": "cspt_path_traversal_marker",
    "pattern": "(?:\\.\\./){2,}|%2[Ff]\\.\\.|decodeURIComponent\\s*\\(",
    "kind": "sink",
    "severity": "low",
    "description": "Path-traversal marker (../../, %2F.., decodeURIComponent) — auxiliary CSPT signal"
  }
]
