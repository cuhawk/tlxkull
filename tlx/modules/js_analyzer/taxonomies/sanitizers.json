[
  {
    "id": "sanitizer_dompurify",
    "pattern": "\\bDOMPurify\\.sanitize\\s*\\(",
    "kind": "sanitizer",
    "severity": "low",
    "description": "DOMPurify.sanitize() — gold-standard HTML sanitiser",
    "clears": ["html", "attribute"]
  },
  {
    "id": "sanitizer_dompurify_namespaced",
    "pattern": "\\b\\w+\\.sanitize\\s*\\(",
    "kind": "sanitizer",
    "severity": "low",
    "description": "Generic .sanitize() — matches DOMPurify renamed at import. High FP rate.",
    "clears": ["html", "attribute"]
  },
  {
    "id": "sanitizer_xss_lib",
    "pattern": "require\\s*\\(\\s*['\"`]xss['\"`]\\s*\\)|from\\s+['\"`]xss['\"`]",
    "kind": "sanitizer",
    "severity": "low",
    "description": "leizongmin/xss package import",
    "clears": ["html"]
  },
  {
    "id": "sanitizer_sanitize_html",
    "pattern": "require\\s*\\(\\s*['\"`]sanitize-html['\"`]\\s*\\)|from\\s+['\"`]sanitize-html['\"`]",
    "kind": "sanitizer",
    "severity": "low",
    "description": "sanitize-html package import",
    "clears": ["html"]
  },
  {
    "id": "sanitizer_lodash_escape",
    "pattern": "\\b_\\.escape\\s*\\(|\\blodash\\.escape\\s*\\(",
    "kind": "sanitizer",
    "severity": "low",
    "description": "lodash _.escape() — HTML entity encoding",
    "clears": ["html"]
  },
  {
    "id": "sanitizer_he_encode",
    "pattern": "\\bhe\\.(encode|escape)\\s*\\(",
    "kind": "sanitizer",
    "severity": "low",
    "description": "he.encode() / he.escape()",
    "clears": ["html"]
  },
  {
    "id": "sanitizer_encodeURIComponent",
    "pattern": "\\bencodeURIComponent\\s*\\(",
    "kind": "sanitizer",
    "severity": "low",
    "description": "encodeURIComponent() — URL context only, not HTML",
    "clears": ["url"]
  },
  {
    "id": "sanitizer_Number_coerce",
    "pattern": "\\bNumber\\s*\\(",
    "kind": "sanitizer",
    "severity": "low",
    "description": "Number(x) — numeric coercion clears arbitrary string taint",
    "clears": ["any"]
  },
  {
    "id": "sanitizer_parseInt_parseFloat",
    "pattern": "\\b(parseInt|parseFloat)\\s*\\(",
    "kind": "sanitizer",
    "severity": "low",
    "description": "parseInt/parseFloat — numeric coercion",
    "clears": ["any"]
  },
  {
    "id": "sanitizer_textContent_assign",
    "pattern": "\\.textContent\\s*=(?!=)",
    "kind": "sanitizer",
    "severity": "low",
    "description": "element.textContent = — auto-escapes, not a sink",
    "clears": ["html"]
  },
  {
    "id": "sanitizer_createTextNode",
    "pattern": "\\bdocument\\.createTextNode\\s*\\(",
    "kind": "sanitizer",
    "severity": "low",
    "description": "document.createTextNode() — text node, not parsed as HTML",
    "clears": ["html"]
  },
  {
    "id": "sanitizer_event_origin_check",
    "pattern": "(event|e|msg|message|ev)\\.origin\\s*[!=]==?\\s*['\"`]",
    "kind": "sanitizer",
    "severity": "low",
    "description": "event.origin strict-equality check — clears postMessage source taint",
    "clears": ["url"]
  },
  {
    "id": "sanitizer_trustedtypes_createHTML",
    "pattern": "\\.createHTML\\s*\\(",
    "kind": "sanitizer",
    "severity": "low",
    "description": "TrustedTypePolicy.createHTML() — returns TrustedHTML",
    "clears": ["html"]
  }
]