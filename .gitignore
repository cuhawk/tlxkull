# Secrets — never commit
**/auth_cache.json
**/identities.json
**/cookies.json
**/.env
**/.env.*
.envrc
**/credentials.json
**/peer_ids.json   # personal — comment this out if you want to commit your own

# TLX runtime state (lives in ~/.tlx anyway, but in case of stray copies)
.tlx/
chroma/

# Per-engagement target dirs (scope, artifacts, findings — all local-only)
targets/*
!targets/_TEMPLATE_http.md

# Wiki lint reports rotate — keep last 7 only (manual)
wiki/_lint_*.md

# Wiki source media (regenerable / huge — only transcripts feed the wiki)
wiki/sources/**/audio_tmp/
wiki/sources/**/*.wav
wiki/sources/**/*.mp3
wiki/sources/**/*.m4a
wiki/sources/**/*.flac
wiki/sources/**/*.ogg
wiki/sources/**/*.mp4
wiki/sources/**/*.mkv
wiki/sources/**/*.webm

# Whisper runtime logs (regenerable — only transcripts are persisted)
wiki/sources/**/whisper/_log.jsonl
wiki/sources/**/whisper/_log.jsonl.*

# Python build crap
__pycache__/
*.pyc
.venv/
.python-version

# Graphify build artifacts (regenerable, big)
graphify-out/

# OS noise
.DS_Store
wiki/_external/
.recon/
recon_mcp/.venv/
recon_mcp/*.egg-info/

# Node deps for js_analyzer AST extractor (package.json is tracked)
tlx/modules/js_analyzer/node_modules/

# Claude scheduler runtime lock
.claude/scheduled_tasks.lock

# Codex CLI local state
.codex/

# Agent skills local cache
.agents/
