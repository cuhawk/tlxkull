# Secrets — never commit
**/auth_cache.json
**/cookies.json
**/.env
**/.env.*
.envrc
**/credentials.json
**/peer_ids.json   # personal — comment this out if you want to commit your own

# TLX runtime state (lives in ~/.tlx anyway, but in case of stray copies)
.tlx/
chroma/

# Per-engagement raw + intermediate (big, regenerable)
targets/*/raw/
targets/*/sources/
targets/*/index/
targets/*/chains/
targets/*/opus/
targets/*/caido/replays/
targets/*/caido/idor/
targets/*/autoresearch.jsonl

# Keep these per-target:
!targets/*/http.md
!targets/*/status.json
!targets/*/notes.md
!targets/*/findings/

# Wiki lint reports rotate — keep last 7 only (manual)
wiki/_lint_*.md

# Python build crap
__pycache__/
*.pyc
.venv/
.python-version

# Graphify build artifacts (regenerable, big)
graphify-out/

# OS noise
.DS_Store
wiki/_external/
.recon/
recon_mcp/.venv/
