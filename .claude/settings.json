{
  "$comment": "TLX Bug-Bounty Workspace — Claude Code settings. Edit env paths to match your machine.",
  "mcpServers": {
    "tlx": {
      "$comment": "Vendored TLX subset. Wrapper sources ~/.config/claude/.env + ./.env, then execs venv python.",
      "command": "/Users/soural/Documents/TLX/bin/tlx-mcp.sh",
      "args": []
    },
    "caido": {
      "$comment": "Local Caido MCP wrapper. Requires Caido GUI running with API enabled.",
      "command": "/Users/soural/Documents/TLX/bin/caido-mcp.sh",
      "args": []
    },
    "chrome-devtools": {
      "$comment": "Real Chrome via DevTools Protocol. Used for live-target browsing through the Caido proxy.",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"],
      "env": {}
    },
    "playwright": {
      "$comment": "Headless Playwright. Used by mock_confirm sink-observation flow.",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "env": {}
    }
  },
